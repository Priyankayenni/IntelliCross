# Frontend Environment Variables Template

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-public-key-here

# API Configuration
VITE_API_URL=https://your-backend.onrender.com

# App Configuration
VITE_ENVIRONMENT=production
VITE_APP_NAME=IntelliCross

# Optional: Analytics
VITE_SENTRY_DSN=https://your-sentry-key@sentry.io/your-project-id

# Optional: Feature Flags
VITE_ENABLE_REALTIME=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_MONITORING=true

# Notes:
# - VITE_SUPABASE_KEY should be your anon (public) key, NOT the service role key
# - VITE_API_URL should be your Render backend URL
# - Never commit this file - add to .gitignore
# - Copy to .env and fill in your values
