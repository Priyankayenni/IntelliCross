# Backend Environment Variables Template

# Database Configuration
DATABASE_URL=postgresql://username:password@host:5432/dbname

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# API Configuration
API_KEY=your-secret-api-key-here
SECRET_KEY=your-very-long-secret-key-for-jwt-here

# Environment
ENVIRONMENT=production
DEBUG=false

# Optional: Security
BCRYPT_ROUNDS=12
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: Monitoring
SENTRY_DSN=https://your-sentry-key@sentry.io/your-project-id

# Optional: External Services
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Notes:
# - DATABASE_URL format: postgresql://user:password@localhost:5432/database_name
# - SUPABASE_KEY should be your service role key (NOT the anon key)
# - Never commit this file - add to .gitignore
# - Use strong, random values for API_KEY and SECRET_KEY
# - Copy to backend/.env and fill in your values
# - Generate strong keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
