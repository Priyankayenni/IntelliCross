# Frontend Environment Configuration
# For local development:
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000

# For production deployment (Vercel, Render Static Site, Netlify):
# Live Render backend URL:
VITE_API_URL=https://intellicross.onrender.com
# VITE_WS_URL is automatically derived as wss://intellicross.onrender.com if omitted:
VITE_WS_URL=wss://intellicross.onrender.com
