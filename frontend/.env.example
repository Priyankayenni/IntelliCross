# Frontend Environment Configuration
# For local development:
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000

# For production on Vercel:
# Set this to your live Render backend URL:
VITE_API_URL=https://intellicross-backend.onrender.com
# VITE_WS_URL is optional - it will automatically use wss:// based on VITE_API_URL
# VITE_WS_URL=wss://intellicross-backend.onrender.com
